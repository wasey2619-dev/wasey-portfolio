# Database URL (used for the contact form message storage).
# In local development this is a SQLite file:
DATABASE_URL="file:./db/custom.db"

# On Vercel/serverless, set DATABASE_URL to a real database connection
# (e.g. Neon Postgres) if you want contact form messages to be stored.
# If left as a local file path, the contact form will still work and
# return success, but messages won't be persisted on serverless.
